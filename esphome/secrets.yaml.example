# Modele de secrets.yaml pour les configurations ESPHome du Smart Locker.
# Copier en secrets.yaml (ignore par git) et remplacer chaque valeur entre guillemets.
#
# Cle API : 44 caracteres se terminant par "=", a coller telle quelle (sans prefixe).
#   - nouvelle carte : en generer une avec `openssl rand -base64 32`
#   - carte deja flashee (migration) : reprendre EXACTEMENT la cle actuelle de la carte,
#     sinon la nouvelle instance HA ne pourra pas s'y connecter.
# Mot de passe OTA : pour une carte deja flashee, reprendre EXACTEMENT le mot de passe
#   actuel, sinon les mises a jour sans fil seront refusees (seul l'USB fonctionnerait).

wifi_ssid: "MonWiFi"
wifi_password: "motdepasse"

# Carte relais (smartlocker-relais.yaml)
smartlocker_relais_api_key: "REMPLACER_PAR_LA_CLE_API_44_CARACTERES="
smartlocker_relais__ota_password: "REMPLACER_PAR_LE_MOT_DE_PASSE_OTA"
smartlocker_relais_fallback_password: "REMPLACER_8_CARACTERES_MIN"

# Digicode (smartlocker-digicode.yaml)
smartlocker_digicode_api_key: "REMPLACER_PAR_LA_CLE_API_44_CARACTERES="
ota_password: "REMPLACER_PAR_LE_MOT_DE_PASSE_OTA"
