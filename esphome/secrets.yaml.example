# Modele de secrets.yaml pour les configurations ESPHome du Smart Locker.
# Copier en secrets.yaml (ignore par git) et renseigner les valeurs.
# Cle API : generer avec `openssl rand -base64 32`.

wifi_ssid: "MonWiFi"
wifi_password: "motdepasse"

# Carte relais (smartlocker-relais.yaml)
smartlocker_relais_api_key: "base64=="
smartlocker_relais__ota_password: "changeme"
smartlocker_relais_fallback_password: "changeme"

# Digicode (smartlocker-digicode.yaml)
smartlocker_digicode_api_key: "base64=="
ota_password: "changeme"
